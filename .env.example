# ── eMeet Backend — variables de entorno ──────────────────────────────────────
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a git.

# Puerto del servidor (Render lo sobreescribe automáticamente)
PORT=4000

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX

# ── Base de datos (Prisma — si se usa directamente) ───────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ── CORS — orígenes permitidos ────────────────────────────────────────────────
# En producción incluir la URL de Vercel:
#   FRONTEND_ORIGIN=https://YOUR-APP.vercel.app,http://localhost:3000
# En desarrollo:
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3008

# URL pública del backend (usada en logs y documentación)
BACKEND_PUBLIC_URL=https://YOUR-BACKEND.onrender.com

# ── Google Maps (Places API — server-side) ────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Pasarelas de pago (opcionales) ───────────────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_access_token

# Transbank — usar integration para pruebas, production para producción real
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=your_transbank_commerce_code
TRANSBANK_API_KEY=your_transbank_api_key
